# Supabase Configuration
# Get these values from your Supabase project settings at https://app.supabase.com

# Supabase project URL (client-side)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous key (client-side, safe to expose)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-side only, keep secret!)
# Only use this for server-side operations, NEVER expose in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
